gametitle=Magna Carta - Tears of Blood NTSC-K (SCKA-20043)
// Original ELF CRC: AE86E04C; offline instruction/context verified.
[60 FPS]
author=Gabominated (NTSC-U original)
description=韩版帧率解锁测试版；游戏内效果待验证。帧率不足时可尝试提高模拟器主处理器时钟。
// 001C69E4: slti at,v0,2 -> slti at,v0,1
patch=1,EE,201C69E4,extended,28410001

// Gameplay ports: static verified; runtime pending.
// Upstream: root670/CheatDevicePS2/CheatDatabase.txt (GPL-3.0).
// Select ONE money-spend mode and ONE item mode at a time.
// JP reference: https://xterminatorex.seesaa.net/category/6006620-2.html
// Disable item modes before equipment changes (JP hang report; KR not tested).

[消费不扣钱]
description=消费时不扣除金钱，但仍需满足原本的余额要求。消费模式只选1项；游戏内效果待验证。
// spend_no_decrease; original AC620000; intUMrtsPartyDataexecSpendMoney
patch=1,EE,003A0700,word,00000000

[消费反加钱]
description=消费金额改为增加金钱，仍需满足原本的余额要求。消费模式只选1项；游戏内效果待验证。
// spend_increase; original 00451023; intUMrtsPartyDataexecSpendMoney
patch=1,EE,003A06F8,word,00451021

[获得金钱时设为最大值]
description=获得金钱时设为韩版原生上限1000000。游戏内效果待验证。
// gain_max_money; original 14200003; intUMrtsPartyDataexecMakeMoney
patch=1,EE,003A0E78,word,00000000

[使用物品不减少]
description=移除或使用物品时保留原数量。物品模式只选1项，装备前关闭；游戏内效果待验证。
// item_no_decrease; original AC620004; intUMrtsPartyDataexecRemoveItem
patch=1,EE,0039FBB0,word,00000000

[使用物品后数量99]
description=移除或使用物品时将数量设为99。物品模式只选1项，装备前关闭；游戏内效果待验证。
// item_count_99; original 00461023; intUMrtsPartyDataexecRemoveItem
patch=1,EE,0039FB98,word,24020063

[使用物品反增加]
description=将物品数量扣减改为增加。物品模式只选1项，装备前关闭；游戏内效果待验证。
// item_increase; original 00461023; intUMrtsPartyDataexecRemoveItem
patch=1,EE,0039FB98,word,00461021

[钱不够也可消费且不扣钱]
description=余额不足时也可消费，并保留现有金钱。消费模式只选1项；游戏内效果待验证。
// spend_free; original 14200004; intUMrtsPartyDataexecSpendMoney
patch=1,EE,003A06F0,word,10000005

[使用物品后数量98]
description=移除或使用物品时将数量设为98。物品模式只选1项，装备前关闭；游戏内效果待验证。
// item_count_98; original 00461023; intUMrtsPartyDataexecRemoveItem
patch=1,EE,0039FB98,word,24020062

// Battle candidates: KR native bindings; runtime acceptance pending.
// HP modes are mutually exclusive. Cold boot after switching/off.
// C1000/C2000 caves: outside original ELF; runtime ownership unverified.

